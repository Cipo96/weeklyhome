# Copia in `.env` e riempi i valori reali. NON committare il .env.
# Su Railway/Render questi vanno impostati come Environment Variables del servizio.

# --- Database (Neon Postgres) ---
# Connessione pooled (pgBouncer) usata dall'app a runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
# Connessione DIRETTA (senza pooling) usata da `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# --- Auth ---
# Segreto per firmare i JWT. Generane uno lungo e casuale (es. `openssl rand -base64 48`).
JWT_SECRET="cambia-questo-con-un-segreto-lungo-e-casuale"

# --- Server ---
# Railway/Render iniettano PORT automaticamente; in locale default 3000.
PORT=3000

# --- Provider prezzi (CSV) ---
PRICE_PROVIDER="conad-catalog,lidl-offers,oasi,eurospin"

# --- AI (estrazione volantini, opzionale) ---
# Senza chiave, il refresh volantini vision viene saltato (gli altri provider funzionano).
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Cron esterno (cron-job.org) ---
# Segreto condiviso per POST /cron/weekly (refresh settimanale volantini innescato
# da uno scheduler esterno). Generane uno lungo e casuale. Senza, l'endpoint è disabilitato.
CRON_SECRET=""
